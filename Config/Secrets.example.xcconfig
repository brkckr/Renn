// Copy to Config/Secrets.xcconfig (git-ignored) and fill in owner-provided values.
// Never commit real signing material or server secrets. The RevenueCat *public* SDK key
// is client configuration, but it is still kept out of git by default.
//
// xcconfig treats "//" as a comment, so write URLs as https:/$()/example.com/path

RENN_DEVELOPMENT_TEAM = ABCDE12345
RENN_REVENUECAT_API_KEY = appl_REPLACE_ME
RENN_SUPPORT_URL = https:/$()/example.com/support
RENN_PRIVACY_URL = https:/$()/example.com/privacy
RENN_TERMS_URL = https:/$()/example.com/terms
