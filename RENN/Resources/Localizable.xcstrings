    "settings.pro.pitch": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Longer videos, supported higher quality and no watermark."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha uzun videolar, desteklenen daha yüksek kalite ve filigransız dışa aktarım."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Videos más largos, mayor calidad compatible y sin marca de agua."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vídeos mais longos, maior qualidade compatível e sem marca d'água."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Längere Videos, höhere unterstützte Qualität und kein Wasserzeichen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vidéos plus longues, meilleure qualité prise en charge et sans filigrane."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "長いビデオ、対応する高画質、透かしなし。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 긴 비디오, 지원되는 더 높은 화질, 워터마크 없음."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更长的视频、支持的更高画质，且无水印。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Более длинные видео, более высокое поддерживаемое качество и без водяного знака."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วิดีโอยาวขึ้น คุณภาพสูงขึ้นที่รองรับ และไม่มีลายน้ำ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Video dài hơn, chất lượng cao hơn được hỗ trợ và không có hình mờ."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Video lebih panjang, kualitas lebih tinggi yang didukung, dan tanpa watermark."
          }
        }
      }
