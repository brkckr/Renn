          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пусть звук оживит ваше видео."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ให้เสียงขับเคลื่อนวิดีโอของคุณ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để âm thanh làm video chuyển động."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Biarkan suara menggerakkan video Anda."
          }
        }
