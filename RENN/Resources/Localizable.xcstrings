    "dual.unavailable.formats": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This iPhone reports dual-camera support, but no compatible front and rear format pair was found. You can still record with one camera or import a video."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu iPhone çift kamerayı destekliyor ancak uyumlu bir ön ve arka format çifti bulunamadı. Yine de tek kamerayla çekebilir veya bir video içe aktarabilirsin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este iPhone indica que admite dos cámaras, pero no se encontró una combinación compatible de formatos frontal y trasero. Aún puedes grabar con una cámara o importar un video."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este iPhone informa que tem suporte a duas câmeras, mas nenhuma combinação compatível de formatos frontal e traseiro foi encontrada. Você ainda pode gravar com uma câmera ou importar um vídeo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses iPhone meldet Unterstützung für zwei Kameras, aber es wurde kein passendes Formatpaar für Front- und Rückkamera gefunden. Du kannst trotzdem mit einer Kamera aufnehmen oder ein Video importieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet iPhone indique prendre en charge deux caméras, mais aucune paire de formats avant et arrière compatible n'a été trouvée. Vous pouvez toujours filmer avec une caméra ou importer une vidéo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このiPhoneはデュアルカメラに対応していますが、互換性のある前面・背面のフォーマットの組み合わせが見つかりませんでした。1台のカメラで録画するか、ビデオを読み込むことはできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 iPhone은 듀얼 카메라를 지원한다고 표시하지만 호환되는 전면·후면 형식 조합을 찾지 못했습니다. 카메라 하나로 녹화하거나 비디오를 가져올 수는 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 iPhone 显示支持双摄像头，但未找到兼容的前后摄像头格式组合。你仍可以用一个摄像头录制或导入视频。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот iPhone сообщает о поддержке двух камер, но совместимая пара форматов для фронтальной и основной камер не найдена. Вы по-прежнему можете снимать на одну камеру или импортировать видео."
          }
        }
      }
    },
    "dual.unavailable.hardware": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This iPhone can't record with the front and rear cameras at the same time. You can still record with one camera or import a video."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu iPhone ön ve arka kamerayla aynı anda kayıt yapamıyor. Yine de tek kamerayla çekebilir veya bir video içe aktarabilirsin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este iPhone no puede grabar con la cámara frontal y la trasera a la vez. Aún puedes grabar con una cámara o importar un video."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este iPhone não consegue gravar com as câmeras frontal e traseira ao mesmo tempo. Você ainda pode gravar com uma câmera ou importar um vídeo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses iPhone kann nicht gleichzeitig mit Front- und Rückkamera aufnehmen. Du kannst trotzdem mit einer Kamera aufnehmen oder ein Video importieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet iPhone ne peut pas filmer avec les caméras avant et arrière en même temps. Vous pouvez toujours filmer avec une caméra ou importer une vidéo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このiPhoneでは前面カメラと背面カメラで同時に録画できません。1台のカメラで録画するか、ビデオを読み込むことはできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 iPhone은 전면과 후면 카메라로 동시에 녹화할 수 없습니다. 카메라 하나로 녹화하거나 비디오를 가져올 수는 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 iPhone 无法同时使用前后摄像头录制。你仍可以用一个摄像头录制或导入视频。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот iPhone не может одновременно снимать на фронтальную и основную камеры. Вы по-прежнему можете снимать на одну камеру или импортировать видео."
          }
        }
      }
    },
    "dual.unavailable.title": {
