    "paywall.unavailable.generic": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plans couldn't be loaded. Check your connection and try again, or keep using RENN Free."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Planlar yüklenemedi. Bağlantını kontrol edip tekrar dene ya da RENN'i ücretsiz kullanmaya devam et."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron cargar los planes. Revisa tu conexión e inténtalo de nuevo, o sigue usando RENN Free."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível carregar os planos. Verifique sua conexão e tente novamente, ou continue usando o RENN Free."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Tarife konnten nicht geladen werden. Prüfe deine Verbindung und versuche es erneut, oder nutze weiter RENN Free."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les formules n'ont pas pu être chargées. Vérifiez votre connexion et réessayez, ou continuez avec RENN Free."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プランを読み込めませんでした。接続を確認してもう一度お試しいただくか、RENN Freeを引き続きご利用ください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요금제를 불러올 수 없습니다. 연결을 확인하고 다시 시도하거나 RENN Free를 계속 사용하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法载入方案。请检查网络连接后重试，或继续使用 RENN Free。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось загрузить тарифы. Проверьте подключение и попробуйте еще раз или продолжайте пользоваться RENN Free."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถโหลดแผนได้ โปรดตรวจสอบการเชื่อมต่อแล้วลองอีกครั้ง หรือใช้ RENN Free ต่อไป"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể tải các gói. Hãy kiểm tra kết nối và thử lại, hoặc tiếp tục dùng RENN Free."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Paket tidak dapat dimuat. Periksa koneksi Anda dan coba lagi, atau tetap gunakan RENN Free."
          }
        }
      }
    },
