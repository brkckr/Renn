    "export.cancelled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export cancelled. Your project is unchanged."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dışa aktarma iptal edildi. Projen değişmedi."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportación cancelada. Tu proyecto no ha cambiado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportação cancelada. Seu projeto não foi alterado."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Export abgebrochen. Dein Projekt ist unverändert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportation annulée. Votre projet n'a pas changé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き出しをキャンセルしました。プロジェクトは変更されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내보내기가 취소되었습니다. 프로젝트는 변경되지 않았습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已取消导出。你的项目没有改变。"
          }
