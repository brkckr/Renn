    "onboarding.page4.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record or import. Let RENN do the rest."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çek veya içe aktar. Gerisini RENN'e bırak."
          }
