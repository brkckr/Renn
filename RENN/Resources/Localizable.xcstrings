        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уведомления третьих сторон для шрифтов и SDK добавляются, когда эти компоненты включены в приложение."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ประกาศของบุคคลที่สามสำหรับฟอนต์และ SDK จะเพิ่มเมื่อรวมส่วนประกอบเหล่านั้นแล้ว"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thông báo bên thứ ba cho phông chữ và SDK được thêm khi các thành phần đó được tích hợp."
