    "onboarding.page2.heading": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every moment has a mood."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her anın bir havası var."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada momento tiene su ambiente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo momento tem um clima."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Moment hat seine Stimmung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque moment a son ambiance."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どの瞬間にも、その空気がある。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 순간에는 분위기가 있어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个瞬间都有它的氛围。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У каждого момента свое настроение."
          }
        }
      }
    },
    "onboarding.page3.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Effects that find rhythm in your video's sound."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Videonun sesine ritimle eşlik eden efektler."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Efectos que siguen el ritmo del sonido de tu video."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Efeitos que encontram o ritmo no som do seu vídeo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Effekte, die den Rhythmus im Ton deines Videos finden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des effets qui trouvent le rythme dans le son de votre vidéo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ビデオの音からリズムを見つけるエフェクト。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비디오의 소리에서 리듬을 찾는 효과."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从视频声音中找到节奏的效果。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эффекты, которые находят ритм в звуке вашего видео."
          }
        }
      }
    },
    "onboarding.page3.heading": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let sound move your video."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesin görüntüyü hareketlendirsin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deja que el sonido mueva tu video."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixe o som mover seu vídeo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass den Ton dein Video bewegen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laissez le son animer votre vidéo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音でビデオを動かそう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소리로 비디오를 움직여 보세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让声音带动你的视频。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пусть звук оживит ваше видео."
          }
        }
      }
    },
    "onboarding.page4.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record or import. Let RENN do the rest."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çek veya içe aktar. Gerisini RENN'e bırak."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Graba o importa. RENN hace el resto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Grave ou importe. O RENN faz o resto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufnehmen oder importieren. RENN macht den Rest."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Filmez ou importez. RENN s'occupe du reste."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録画するか読み込むだけ。あとはRENNにおまかせ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹화하거나 가져오세요. 나머지는 RENN이 합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
