    "dual.unavailable.formats": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This iPhone reports dual-camera support, but no compatible front and rear format pair was found. You can still record with one camera or import a video."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu iPhone çift kamerayı destekliyor ancak uyumlu bir ön ve arka format çifti bulunamadı. Yine de tek kamerayla çekebilir veya bir video içe aktarabilirsin."
          }
        }
      }
    },
