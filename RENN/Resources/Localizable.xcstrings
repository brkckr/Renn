            "value": "Video proje olarak kaydedilemedi. Lütfen tekrar dene."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar el video como proyecto. Inténtalo de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar o vídeo como projeto. Tente novamente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Video konnte nicht als Projekt gesichert werden. Bitte versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La vidéo n'a pas pu être sauvegardée comme projet. Veuillez réessayer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ビデオをプロジェクトとして保存できませんでした。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비디오를 프로젝트로 저장할 수 없습니다. 다시 시도하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法将视频保存为项目。请重试。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сохранить видео как проект. Попробуйте еще раз."
          }
        }
      }
    },
    "import.failed.storage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There isn't enough free space on this iPhone. Free up some space and try again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu iPhone'da yeterli boş alan yok. Biraz yer açıp tekrar dene."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay suficiente espacio libre en este iPhone. Libera espacio e inténtalo de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há espaço livre suficiente neste iPhone. Libere espaço e tente novamente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht genug freier Speicher auf diesem iPhone. Gib Speicher frei und versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Espace libre insuffisant sur cet iPhone. Libérez de l'espace et réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このiPhoneの空き容量が足りません。空き容量を増やしてもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 iPhone의 저장 공간이 부족합니다. 공간을 확보한 후 다시 시도하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 iPhone 的可用空间不足。请释放空间后重试。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На этом iPhone недостаточно свободного места. Освободите место и попробуйте еще раз."
          }
        }
      }
    },
    "import.failed.unreadable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This video couldn't be opened. It may still be downloading from iCloud or be damaged."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu video açılamadı. iCloud'dan hâlâ iniyor olabilir ya da bozuk olabilir."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo abrir este video. Puede que aún se esté descargando de iCloud o que esté dañado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível abrir este vídeo. Ele pode ainda estar baixando do iCloud ou estar danificado."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Video konnte nicht geöffnet werden. Möglicherweise wird es noch aus iCloud geladen oder ist beschädigt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette vidéo n'a pas pu être ouverte. Elle est peut-être encore en cours de téléchargement depuis iCloud ou endommagée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このビデオを開けませんでした。iCloudからダウンロード中か、破損している可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 비디오를 열 수 없습니다. iCloud에서 다운로드 중이거나 손상되었을 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法打开此视频。它可能仍在从 iCloud 下载，或者已损坏。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось открыть это видео. Возможно, оно еще загружается из iCloud или повреждено."
          }
        }
      }
    },
    "import.failed.unsupported": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This video format isn't supported yet. Try a standard H.264 or HEVC video."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu video biçimi henüz desteklenmiyor. Standart bir H.264 veya HEVC video dene."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este formato de video aún no es compatible. Prueba con un video H.264 o HEVC estándar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este formato de vídeo ainda não é compatível. Tente um vídeo H.264 ou HEVC padrão."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Videoformat wird noch nicht unterstützt. Versuche ein normales H.264- oder HEVC-Video."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce format vidéo n'est pas encore pris en charge. Essayez une vidéo H.264 ou HEVC standard."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このビデオ形式にはまだ対応していません。標準的なH.264またはHEVCのビデオをお試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 비디오 형식은 아직 지원되지 않습니다. 일반적인 H.264 또는 HEVC 비디오로 시도해 보세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂不支持此视频格式。请尝试标准的 H.264 或 HEVC 视频。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот формат видео пока не поддерживается. Попробуйте обычное видео H.264 или HEVC."
          }
        }
      }
    },
