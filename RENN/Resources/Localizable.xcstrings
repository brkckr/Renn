    "look.odd_lot.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cross-processed yellows and deep teal."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çapraz banyo sarıları ve koyu camgöbeği."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Amarillos de proceso cruzado y verde azulado profundo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Amarelos de processo cruzado e verde-azulado profundo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Crossentwickelte Gelbtöne und tiefes Petrol."
