    "import.limit.body %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This video is %@ long. RENN Pro has no duration limit, or you can choose another video. RENN never trims your video automatically."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu video %@ uzunluğunda. RENN Pro'da süre sınırı yok ya da başka bir video seçebilirsin. RENN videonu hiçbir zaman otomatik kırpmaz."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este video dura %@. RENN Pro no tiene límite de duración, o puedes elegir otro video. RENN nunca recorta tu video automáticamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este vídeo tem %@. O RENN Pro não tem limite de duração, ou você pode escolher outro vídeo. O RENN nunca corta seu vídeo automaticamente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Video ist %@ lang. RENN Pro hat keine Längenbegrenzung, oder du wählst ein anderes Video. RENN kürzt dein Video nie automatisch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette vidéo dure %@. RENN Pro n'a pas de limite de durée, ou vous pouvez choisir une autre vidéo. RENN ne coupe jamais votre vidéo automatiquement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このビデオの長さは%@です。RENN Proなら長さの制限がありません。別のビデオを選ぶこともできます。RENNがビデオを自動でカットすることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 비디오의 길이는 %@입니다. RENN Pro는 길이 제한이 없으며, 다른 비디오를 선택할 수도 있습니다. RENN은 비디오를 자동으로 자르지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此视频时长为 %@。RENN Pro 没有时长限制，你也可以选择其他视频。RENN 绝不会自动剪短你的视频。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Длительность этого видео — %@. В RENN Pro нет ограничения по длительности, или вы можете выбрать другое видео. RENN никогда не обрезает видео автоматически."
          }
        }
      }
    },
