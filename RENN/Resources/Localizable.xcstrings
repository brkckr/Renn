          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Снимайте сегодня в другой эпохе."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกวันนี้ในอีกยุคหนึ่ง"
