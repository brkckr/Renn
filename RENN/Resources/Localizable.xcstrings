    "settings.diagnostics.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional anonymous usage and crash data. Never includes your videos, names or files. Off unless you turn it on."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İsteğe bağlı anonim kullanım ve çökme verileri. Videoların, adların veya dosyaların asla dahil edilmez. Sen açmadıkça kapalıdır."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Datos anónimos opcionales de uso y fallos. Nunca incluyen tus videos, nombres ni archivos. Desactivado salvo que lo actives."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dados anônimos opcionais de uso e falhas. Nunca incluem seus vídeos, nomes ou arquivos. Desativado a menos que você ative."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Optionale anonyme Nutzungs- und Absturzdaten. Enthalten nie deine Videos, Namen oder Dateien. Aus, bis du sie einschaltest."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Données anonymes facultatives d'utilisation et de plantage. N'incluent jamais vos vidéos, noms ou fichiers. Désactivé sauf si vous l'activez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "任意の匿名の利用データとクラッシュデータです。ビデオ、名前、ファイルは含まれません。オンにしない限りオフです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택 사항인 익명 사용 및 충돌 데이터입니다. 비디오, 이름, 파일은 포함되지 않습니다. 직접 켜지 않으면 꺼져 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可选的匿名使用和崩溃数据。绝不包含你的视频、名称或文件。除非你打开，否则保持关闭。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Необязательные анонимные данные об использовании и сбоях. Никогда не включают ваши видео, имена или файлы. Выключено, пока вы не включите."
          }
        }
      }
    },
