    "look.sepia_tape.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Warm sepia, like a worn archive tape."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yıpranmış bir arşiv kaseti gibi sıcak sepya."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sepia cálido, como una cinta de archivo gastada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sépia quente, como uma fita de arquivo gasta."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warmes Sepia wie ein abgenutztes Archivband."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sépia chaud, comme une cassette d'archive usée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使い込まれた記録テープのような暖かいセピア。"
