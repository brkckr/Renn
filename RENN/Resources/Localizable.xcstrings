    "export.requiresPro.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "RENN Free exports up to 30 seconds. RENN Pro has no duration limit. RENN never trims your video automatically."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "RENN Free en fazla 30 saniye dışa aktarır. RENN Pro'da süre sınırı yok. RENN videonu hiçbir zaman otomatik kırpmaz."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "RENN Free exporta hasta 30 segundos. RENN Pro no tiene límite de duración. RENN nunca recorta tu video automáticamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O RENN Free exporta até 30 segundos. O RENN Pro não tem limite de duração. O RENN nunca corta seu vídeo automaticamente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "RENN Free exportiert bis zu 30 Sekunden. RENN Pro hat keine Längenbegrenzung. RENN kürzt dein Video nie automatisch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "RENN Free exporte jusqu'à 30 secondes. RENN Pro n'a pas de limite de durée. RENN ne coupe jamais votre vidéo automatiquement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "RENN Freeで書き出せるのは30秒までです。RENN Proには長さの制限がありません。RENNがビデオを自動でカットすることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "RENN Free는 최대 30초까지 내보냅니다. RENN Pro는 길이 제한이 없습니다. RENN은 비디오를 자동으로 자르지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "RENN Free 最多可导出 30 秒。RENN Pro 没有时长限制。RENN 绝不会自动剪短你的视频。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "RENN Free экспортирует до 30 секунд. В RENN Pro нет ограничения по длительности. RENN никогда не обрезает видео автоматически."
          }
        }
      }
    },
