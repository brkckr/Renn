    "settings.storage.cacheFooter": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clearing the cache only removes cover images RENN can recreate. Your projects stay."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önbelleği temizlemek yalnızca RENN'in yeniden oluşturabileceği kapak görsellerini siler. Projelerin olduğu gibi kalır."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Borrar la caché solo elimina las portadas que RENN puede volver a crear. Tus proyectos se conservan."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpar o cache só remove as capas que o RENN consegue recriar. Seus projetos continuam."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Leeren des Caches entfernt nur Coverbilder, die RENN neu erstellen kann. Deine Projekte bleiben erhalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vider le cache supprime seulement les couvertures que RENN peut recréer. Vos projets restent."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャッシュを消去しても、RENNが再作成できるカバー画像が削除されるだけです。プロジェクトは残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캐시를 지우면 RENN이 다시 만들 수 있는 커버 이미지만 삭제됩니다. 프로젝트는 그대로 남습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清除缓存只会删除 RENN 可以重新生成的封面图片。你的项目会保留。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Очистка кэша удаляет только обложки, которые RENN может создать заново. Ваши проекты останутся."
          }
        }
      }
    },
