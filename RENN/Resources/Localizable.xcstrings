    "dual.quality.disclosure": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Both cameras record at up to 1080p, 30 FPS."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İki kamera da en fazla 1080p, 30 FPS kaydeder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambas cámaras graban hasta 1080p y 30 FPS."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As duas câmeras gravam em até 1080p e 30 FPS."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beide Kameras nehmen mit bis zu 1080p und 30 FPS auf."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les deux caméras filment jusqu'en 1080p à 30 FPS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "両方のカメラとも最大1080p・30 FPSで録画します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 카메라 모두 최대 1080p, 30 FPS로 녹화합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两个摄像头均以最高 1080p、30 FPS 录制。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обе камеры записывают в разрешении до 1080p при 30 FPS."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กล้องทั้งสองบันทึกได้สูงสุด 1080p ที่ 30 FPS"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cả hai camera quay tối đa 1080p, 30 FPS."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kedua kamera merekam hingga 1080p, 30 FPS."
          }
        }
      }
    },
