        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi lại hôm nay ở một thời đại khác."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Abadikan hari ini di zaman yang lain."
          }
        }
      }
