          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Снимите или импортируйте. Остальное сделает RENN."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกหรือนำเข้า ที่เหลือให้ RENN จัดการ"
