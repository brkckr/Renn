    "projects.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your projects can't be opened by this version of RENN. Update the app to open them; nothing has been deleted."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Projelerin RENN'in bu sürümüyle açılamıyor. Açmak için uygulamayı güncelle; hiçbir şey silinmedi."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versión de RENN no puede abrir tus proyectos. Actualiza la app para abrirlos; no se ha eliminado nada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versão do RENN não consegue abrir seus projetos. Atualize o app para abri-los; nada foi apagado."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Version von RENN kann deine Projekte nicht öffnen. Aktualisiere die App, um sie zu öffnen; es wurde nichts gelöscht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette version de RENN ne peut pas ouvrir vos projets. Mettez l'app à jour pour les ouvrir ; rien n'a été supprimé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このバージョンのRENNではプロジェクトを開けません。アプリをアップデートすると開けます。何も削除されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 버전의 RENN에서는 프로젝트를 열 수 없습니다. 앱을 업데이트하면 열 수 있으며, 아무것도 삭제되지 않았습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本的 RENN 无法打开你的项目。请更新 App 以打开它们；没有任何内容被删除。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта версия RENN не может открыть ваши проекты. Обновите приложение, чтобы открыть их; ничего не удалено."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "RENN เวอร์ชันนี้เปิดโปรเจกต์ของคุณไม่ได้ อัปเดตแอปเพื่อเปิด ไม่มีสิ่งใดถูกลบ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phiên bản RENN này không mở được dự án của bạn. Hãy cập nhật ứng dụng để mở; không có gì bị xóa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Versi RENN ini tidak dapat membuka proyek Anda. Perbarui app untuk membukanya; tidak ada yang dihapus."
          }
        }
      }
    },
