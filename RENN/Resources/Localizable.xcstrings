{
  "sourceLanguage": "en",
  "strings": {
    "camera.beat.silent": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No microphone access, so this take has no sound and Beat can't respond. The Look still applies."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon izni olmadığı için bu çekimde ses yok ve Beat tepki veremez. Look yine uygulanır."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin acceso al micrófono, esta toma no tiene sonido y Beat no puede reaccionar. El Look se sigue aplicando."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem acesso ao microfone, esta gravação não tem som e o Beat não pode reagir. O Look continua aplicado."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Mikrofonzugriff: Diese Aufnahme hat keinen Ton und Beat kann nicht reagieren. Der Look wird trotzdem angewendet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans accès au micro, cette prise n'a pas de son et Beat ne peut pas réagir. Le Look reste appliqué."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイクへのアクセスがないため、このテイクには音声がなく、Beatは反応できません。Lookはそのまま適用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마이크 접근 권한이 없어 이 촬영에는 소리가 없고 Beat가 반응할 수 없습니다. Look은 그대로 적용됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有麦克风权限，这段录制没有声音，Beat 无法响应。Look 仍会应用。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет доступа к микрофону, поэтому у этого дубля нет звука и Beat не может реагировать. Look по-прежнему применяется."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีสิทธิ์เข้าถึงไมโครโฟน เทคนี้จึงไม่มีเสียงและ Beat ไม่สามารถตอบสนองได้ Look ยังคงถูกใช้อยู่"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có quyền truy cập micrô nên cảnh quay này không có âm thanh và Beat không thể phản hồi. Look vẫn được áp dụng."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada akses mikrofon, jadi rekaman ini tidak bersuara dan Beat tidak bisa merespons. Look tetap diterapkan."
          }
        }
      }
    },
    "camera.countdown %lld": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording starts in %lld"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıt %lld saniye sonra başlıyor"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La grabación empieza en %lld"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A gravação começa em %lld"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufnahme startet in %lld"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'enregistrement commence dans %lld"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld秒後に録画を開始"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld초 후 녹화 시작"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 秒后开始录制"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запись начнется через %lld"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เริ่มบันทึกใน %lld"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bắt đầu quay sau %lld"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perekaman dimulai dalam %lld"
          }
        }
      }
    },
    "camera.failed.denied": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "RENN needs camera access to record. You can allow it in Settings, or import a video instead."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıt için RENN'in kamera iznine ihtiyacı var. İzni Ayarlar'dan verebilir ya da bunun yerine bir video içe aktarabilirsin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "RENN necesita acceso a la cámara para grabar. Puedes permitirlo en Ajustes o importar un video."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O RENN precisa de acesso à câmera para gravar. Você pode permitir nos Ajustes ou importar um vídeo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "RENN braucht Kamerazugriff zum Aufnehmen. Du kannst ihn in den Einstellungen erlauben oder stattdessen ein Video importieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "RENN a besoin d'accéder à l'appareil photo pour filmer. Vous pouvez l'autoriser dans Réglages ou importer une vidéo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録画するにはカメラへのアクセスが必要です。設定で許可するか、代わりにビデオを読み込んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹화하려면 카메라 접근 권한이 필요합니다. 설정에서 허용하거나 대신 비디오를 가져오세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "RENN 需要相机权限才能录制。你可以在“设置”中允许，或改为导入视频。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "RENN нужен доступ к камере для записи. Разрешите его в Настройках или импортируйте видео."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "RENN ต้องใช้สิทธิ์เข้าถึงกล้องเพื่อบันทึก คุณสามารถอนุญาตได้ในการตั้งค่า หรือนำเข้าวิดีโอแทน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "RENN cần quyền truy cập camera để quay. Bạn có thể cho phép trong Cài đặt hoặc nhập video thay thế."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "RENN memerlukan akses kamera untuk merekam. Anda bisa mengizinkannya di Pengaturan, atau mengimpor video."
          }
        }
      }
    },
    "camera.failed.recording": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recording couldn't be completed."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıt tamamlanamadı."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo completar la grabación."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível concluir a gravação."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufnahme konnte nicht abgeschlossen werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'enregistrement n'a pas pu être terminé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録画を完了できませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹화를 완료할 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法完成录制。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось завершить запись."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถบันทึกให้เสร็จได้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể hoàn tất việc quay."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perekaman tidak dapat diselesaikan."
          }
        }
      }
    },
    "camera.failed.save": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recording couldn't be saved as a project. Please try again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıt proje olarak kaydedilemedi. Lütfen tekrar dene."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar la grabación como proyecto. Inténtalo de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar a gravação como projeto. Tente novamente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufnahme konnte nicht als Projekt gesichert werden. Bitte versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'enregistrement n'a pas pu être sauvegardé comme projet. Veuillez réessayer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録画をプロジェクトとして保存できませんでした。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹화를 프로젝트로 저장할 수 없습니다. 다시 시도하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法将录制内容保存为项目。请重试。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сохранить запись как проект. Попробуйте еще раз."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถบันทึกวิดีโอเป็นโปรเจกต์ได้ โปรดลองอีกครั้ง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể lưu bản quay thành dự án. Vui lòng thử lại."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekaman tidak dapat disimpan sebagai proyek. Silakan coba lagi."
          }
        }
      }
    },
    "camera.failed.storage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There isn't enough free space to record. Free up some space and try again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıt için yeterli boş alan yok. Biraz yer açıp tekrar dene."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay suficiente espacio libre para grabar. Libera espacio e inténtalo de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há espaço livre suficiente para gravar. Libere espaço e tente novamente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht genug freier Speicher für die Aufnahme. Gib Speicher frei und versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Espace libre insuffisant pour filmer. Libérez de l'espace et réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録画に必要な空き容量がありません。空き容量を増やしてもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹화할 저장 공간이 부족합니다. 공간을 확보한 후 다시 시도하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可用空间不足，无法录制。请释放空间后重试。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Недостаточно свободного места для записи. Освободите место и попробуйте еще раз."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พื้นที่ว่างไม่พอสำหรับการบันทึก โปรดเพิ่มพื้นที่ว่างแล้วลองอีกครั้ง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không đủ dung lượng trống để quay. Hãy giải phóng dung lượng và thử lại."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruang kosong tidak cukup untuk merekam. Kosongkan ruang dan coba lagi."
          }
        }
      }
    },
    "camera.failed.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The camera couldn't be started. It may be in use by another app."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera başlatılamadı. Başka bir uygulama kullanıyor olabilir."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo iniciar la cámara. Puede que otra app la esté usando."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível iniciar a câmera. Talvez outro app esteja usando."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kamera konnte nicht gestartet werden. Möglicherweise wird sie von einer anderen App verwendet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'appareil photo n'a pas pu démarrer. Il est peut-être utilisé par une autre app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラを起動できませんでした。ほかのアプリが使用している可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라를 시작할 수 없습니다. 다른 앱에서 사용 중일 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法启动相机。它可能正被其他 App 使用。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось запустить камеру. Возможно, она используется другим приложением."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถเปิดกล้องได้ อาจมีแอปอื่นกำลังใช้งานอยู่"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể khởi động camera. Có thể một ứng dụng khác đang sử dụng."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera tidak dapat dimulai. Mungkin sedang digunakan oleh app lain."
          }
        }
      }
    },
