    "preview.beat.muted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sound is muted, so Beat is paused. Unmute to bring it back."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses kapalı olduğu için Beat duraklatıldı. Geri getirmek için sesi aç."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El sonido está silenciado, así que Beat está en pausa. Activa el sonido para recuperarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O som está mudo, então o Beat está pausado. Ative o som para trazê-lo de volta."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Ton ist stumm, daher ist Beat pausiert. Schalte den Ton ein, um ihn zurückzuholen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le son est coupé, Beat est donc en pause. Réactivez le son pour le retrouver."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声がミュートされているため、Beatは一時停止中です。ミュートを解除すると再開します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소리가 음소거되어 Beat가 일시 정지되었습니다. 음소거를 해제하면 다시 작동합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "声音已静音，Beat 已暂停。取消静音即可恢复。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Звук выключен, поэтому Beat приостановлен. Включите звук, чтобы вернуть его."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปิดเสียงอยู่ Beat จึงหยุดชั่วคราว เปิดเสียงเพื่อให้กลับมาทำงาน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Âm thanh đang tắt nên Beat bị tạm dừng. Bật âm thanh để khôi phục."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Suara dibisukan, jadi Beat dijeda. Aktifkan suara untuk mengembalikannya."
          }
        }
      }
    },
