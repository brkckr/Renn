    "look.handycam_green.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The green cast of an old home camcorder."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eski bir el kamerasının yeşilimsi rengi."
