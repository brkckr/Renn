    "look.sunday_polaroid.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Soft, faded warmth like an old family photo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eski bir aile fotoğrafı gibi yumuşak, solgun bir sıcaklık."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Calidez suave y desvaída, como una vieja foto familiar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Calor suave e desbotado, como uma velha foto de família."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sanfte, verblasste Wärme wie ein altes Familienfoto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaleur douce et délavée, comme une vieille photo de famille."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "古い家族写真のような、柔らかく色あせた暖かさ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오래된 가족사진처럼 부드럽고 바랜 따스함."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "柔和褪色的温暖，像一张老家庭照片。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мягкое выцветшее тепло, как на старом семейном фото."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ความอบอุ่นที่นุ่มนวลและซีดจาง เหมือนรูปครอบครัวเก่า"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sự ấm áp dịu nhẹ và phai màu như một tấm ảnh gia đình cũ."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kehangatan lembut dan pudar seperti foto keluarga lama."
          }
        }
      }
    },
