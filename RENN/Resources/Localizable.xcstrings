            "value": "Third-party notices for fonts and SDKs are added when those components are bundled."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yazı tipleri ve SDK'lar için üçüncü taraf bildirimleri, bu bileşenler eklendiğinde burada yer alacak."
          }
        },
        "es": {
          "stringUnit": {
