        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay suficiente espacio libre para exportar. Tu proyecto no ha cambiado; libera espacio e inténtalo de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há espaço livre suficiente para exportar. Seu projeto não foi alterado; libere espaço e tente novamente."
          }
