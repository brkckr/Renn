    "looks.developmentCatalog %lld %lld": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Development catalog: %1$lld diagnostic fixture(s). The %2$lld launch Looks arrive with the final assets."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geliştirme kataloğu: %1$lld tanılama örneği. %2$lld çıkış Look'u nihai varlıklarla gelecek."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Catálogo de desarrollo: %1$lld recurso(s) de diagnóstico. Los %2$lld Looks de lanzamiento llegan con los recursos finales."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Catálogo de desenvolvimento: %1$lld recurso(s) de diagnóstico. Os %2$lld Looks de lançamento chegam com os recursos finais."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entwicklungskatalog: %1$lld Diagnose-Fixture(s). Die %2$lld Launch-Looks kommen mit den finalen Assets."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Catalogue de développement : %1$lld élément(s) de diagnostic. Les %2$lld Looks de lancement arrivent avec les ressources finales."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開発用カタログ：診断用素材%1$lld件。正式な%2$lld個のLookは最終素材とともに追加されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개발용 카탈로그: 진단 항목 %1$lld개. 출시용 Look %2$lld개는 최종 에셋과 함께 추가됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开发目录：%1$lld 个诊断素材。%2$lld 个正式 Look 将随最终素材提供。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каталог разработки: диагностических элементов — %1$lld. %2$lld Look для запуска появятся вместе с финальными материалами."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แคตตาล็อกสำหรับพัฒนา: เนื้อหาวินิจฉัย %1$lld รายการ Look สำหรับเปิดตัว %2$lld แบบจะมาพร้อมไฟล์ฉบับสุดท้าย"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Danh mục phát triển: %1$lld nội dung chẩn đoán. %2$lld Look chính thức sẽ có cùng các tài nguyên cuối cùng."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Katalog pengembangan: %1$lld konten diagnostik. %2$lld Look peluncuran hadir bersama aset final."
          }
        }
      }
    },
