    "onboarding.page1.heading": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture today in another time."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugünü başka bir zamanda çek."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Graba el presente en otra época."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Grave o hoje em outra época."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte das Heute in einer anderen Zeit fest."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Filmez aujourd'hui dans une autre époque."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日を、別の時代で撮ろう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘을 다른 시대로 담아 보세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
