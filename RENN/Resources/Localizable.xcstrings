    "settings.storage.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Projects are stored only on this iPhone. Deleting the app removes them; restoring purchases doesn't restore videos."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Projeler yalnızca bu iPhone'da saklanır. Uygulamayı silmek projeleri de siler; satın almaları geri yüklemek videoları geri getirmez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los proyectos se guardan solo en este iPhone. Eliminar la app los borra; restaurar compras no recupera los videos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os projetos ficam salvos só neste iPhone. Apagar o app os remove; restaurar compras não recupera vídeos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Projekte werden nur auf diesem iPhone gespeichert. Wenn du die App löschst, werden sie entfernt; das Wiederherstellen von Käufen stellt keine Videos wieder her."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les projets sont stockés uniquement sur cet iPhone. Supprimer l'app les efface ; restaurer les achats ne restaure pas les vidéos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロジェクトはこのiPhoneにのみ保存されます。アプリを削除するとプロジェクトも削除され、購入を復元してもビデオは戻りません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로젝트는 이 iPhone에만 저장됩니다. 앱을 삭제하면 프로젝트도 삭제되며, 구매를 복원해도 비디오는 복원되지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "项目只存储在这台 iPhone 上。删除 App 会移除项目；恢复购买不会恢复视频。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проекты хранятся только на этом iPhone. При удалении приложения они удаляются; восстановление покупок не возвращает видео."
          }
        }
      }
    },
