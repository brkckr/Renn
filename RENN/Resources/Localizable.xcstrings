    "projects.delete.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It will be removed from RENN on this iPhone. Videos already saved to Photos stay in Photos."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaset bu iPhone'daki RENN'den kaldırılır. Fotoğraflar'a kaydedilmiş videolar orada kalır."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminará de RENN en este iPhone. Los videos ya guardados en Fotos permanecen en Fotos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ela será removida do RENN neste iPhone. Vídeos já salvos no Fotos continuam no Fotos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wird aus RENN auf diesem iPhone entfernt. Bereits in Fotos gesicherte Videos bleiben in Fotos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle sera supprimée de RENN sur cet iPhone. Les vidéos déjà enregistrées dans Photos y restent."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このiPhoneのRENNから削除されます。すでに写真に保存したビデオは写真に残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 iPhone의 RENN에서 삭제됩니다. 이미 사진에 저장된 비디오는 사진에 남아 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它将从这台 iPhone 上的 RENN 中移除。已保存到“照片”的视频会保留在“照片”中。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Она будет удалена из RENN на этом iPhone. Видео, уже сохраненные в Фото, останутся в Фото."
          }
        }
      }
    },
