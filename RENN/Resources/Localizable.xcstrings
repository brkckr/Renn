        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzun veya yüksek kaliteli videolar biraz sürebilir. İşlem bitene kadar RENN'i açık tut."
          }
        },
        "es": {
          "stringUnit": {
