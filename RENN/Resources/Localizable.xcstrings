    "look.tungsten_days.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pink skies and the glow of expired film."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembe gökyüzü ve eskimiş filmin parıltısı."
          }
        },
