    "export.cancelled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export cancelled. Your project is unchanged."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dışa aktarma iptal edildi. Projen değişmedi."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportación cancelada. Tu proyecto no ha cambiado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportação cancelada. Seu projeto não foi alterado."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Export abgebrochen. Dein Projekt ist unverändert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportation annulée. Votre projet n'a pas changé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き出しをキャンセルしました。プロジェクトは変更されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내보내기가 취소되었습니다. 프로젝트는 변경되지 않았습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已取消导出。你的项目没有改变。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Экспорт отменен. Ваш проект не изменился."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยกเลิกการส่งออกแล้ว โปรเจกต์ของคุณไม่มีการเปลี่ยนแปลง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã hủy xuất. Dự án của bạn không thay đổi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekspor dibatalkan. Proyek Anda tidak berubah."
          }
        }
      }
    },
    "export.failed.generic": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The video couldn't be exported. Your project and its original video are unchanged."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Video dışa aktarılamadı. Projen ve orijinal videon değişmedi."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo exportar el video. Tu proyecto y su video original no han cambiado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível exportar o vídeo. Seu projeto e o vídeo original não foram alterados."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Video konnte nicht exportiert werden. Dein Projekt und das Originalvideo sind unverändert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La vidéo n'a pas pu être exportée. Votre projet et sa vidéo originale n'ont pas changé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ビデオを書き出せませんでした。プロジェクトと元のビデオは変更されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비디오를 내보낼 수 없습니다. 프로젝트와 원본 비디오는 변경되지 않았습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法导出视频。你的项目和原始视频没有改变。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось экспортировать видео. Ваш проект и исходное видео не изменились."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถส่งออกวิดีโอได้ โปรเจกต์และวิดีโอต้นฉบับไม่มีการเปลี่ยนแปลง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể xuất video. Dự án và video gốc của bạn không thay đổi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Video tidak dapat diekspor. Proyek dan video aslinya tidak berubah."
          }
        }
      }
