    "look.dev.diagnostic.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Development fixture used to verify the media pipeline. Not a final RENN Look."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Medya hattını doğrulamak için kullanılan geliştirme örneği. Nihai bir RENN Look'u değildir."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recurso de desarrollo para verificar el proceso multimedia. No es un Look final de RENN."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Recurso de desenvolvimento para verificar o processamento de mídia. Não é um Look final do RENN."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entwicklungs-Fixture zur Prüfung der Medienverarbeitung. Kein finaler RENN-Look."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Élément de développement pour vérifier le traitement média. Pas un Look RENN définitif."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メディア処理の検証用の開発素材です。RENNの正式なLookではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미디어 처리 과정을 확인하기 위한 개발용 항목입니다. 최종 RENN Look이 아닙니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于验证媒体处理流程的开发素材。不是最终的 RENN Look。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тестовый элемент для проверки обработки медиа. Не финальный Look RENN."
          }
        }
      }
    },
