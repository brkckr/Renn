    "look.rainy_matinee.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Soft teal shadows and a quiet, rainy mood."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yumuşak camgöbeği gölgeler ve sakin, yağmurlu bir hava."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sombras suaves verde azulado y un ambiente tranquilo y lluvioso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sombras suaves verde-azuladas e um clima calmo e chuvoso."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weiche petrolfarbene Schatten und eine ruhige, verregnete Stimmung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ombres douces bleu canard et une ambiance calme et pluvieuse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "柔らかなティールの影と、静かな雨の日の雰囲気。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "부드러운 청록빛 그림자와 조용한 비 오는 날의 분위기."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "柔和的青色阴影与安静的雨天氛围。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мягкие бирюзовые тени и спокойное дождливое настроение."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เงาสีเขียวอมฟ้าที่นุ่มนวลและบรรยากาศฝนตกที่สงบ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bóng đổ xanh mòng két dịu nhẹ và bầu không khí mưa yên tĩnh."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bayangan hijau kebiruan yang lembut dan suasana hujan yang tenang."
          }
        }
      }
    },
