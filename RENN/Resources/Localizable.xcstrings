    "settings.language.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App text follows this choice. Store prices use your App Store region."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama metinleri bu seçimi izler. Mağaza fiyatları App Store bölgene göre gösterilir."
          }
